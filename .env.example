# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# GitHub App that registers the runners (required)
APP_ID=
APP_PRIVATE_KEY=
# Organization the runners register to
APP_LOGIN=

# How many runners this host runs; `hosts/sizing.sh [light|large]` suggests a
# value from its CPUs, memory and disk.
RUNNERS=3
# Host directory for every runner's work dir and caches, mounted at the same
# path in the containers (slots/<id>/work, slots/<id>/cache). Put it on a disk
# with room; old named volumes from before slots can be removed.
# RUNNER_DATA_DIR=/var/lib/github-runner

# Runner identity. The runner adds self-hosted, the OS and the architecture to
# LABELS itself; add the capability labels your workflows select on.
RUNNER_NAME_PREFIX=runner
LABELS=docker
RUNNER_GROUP=Default
# One runner can join an extra pool, e.g. a host whose runners are `light` with
# one that also builds (slot 3):
# RUNNER_3_LABELS=docker,x86,light,large

# Coordination runners labelled CONTROL_LABELS, for the short jobs a merge
# waits on. None unless set:
# CONTROL_RUNNERS=2
# CONTROL_LABELS=control

# Small hosts without room for caches (e.g. ARM64 boards): jobs then start
# cold. The pruner's budget already shrinks with the disk, so try that first.
# RUNNER_CACHES=off

# Action archive cache (see README). Space-separated owner/repo@ref lists.
# PREFETCH_SOURCES=my-org/my-workflows@main   # repos scanned for `uses:`
# PREFETCH_EXTRA=actions/checkout@v4          # actions fetched as-is

# Host-wide Maven proxy (see README): Gradle resolves Maven Central, Google
# Maven and the Plugin Portal through the maven-proxy service, or upstream
# whenever it does not answer. `off` sends Gradle straight upstream.
# MAVEN_PROXY=off
# MAVEN_PROXY_MAX_SIZE=20g
# Upstreams the proxy fetches from (defaults: the public repositories):
# MAVEN_CENTRAL_URL=https://repo.maven.apache.org/maven2
# Asked when Central answers 429 or 5xx; set it to MAVEN_CENTRAL_URL to turn that off:
# MAVEN_CENTRAL_MIRROR_URL=https://maven-central.storage-download.googleapis.com/maven2
# GOOGLE_MAVEN_URL=https://dl.google.com/dl/android/maven2
# GRADLE_PLUGIN_PORTAL_URL=https://plugins.gradle.org/m2

# Images and containers of other workloads on this host, which the pruner must
# leave alone. Space-separated; both empty by default. Needs Docker 25+.
# Labels (key or key=value): images and stopped containers carrying any of them,
# and the image a kept container uses.
# DOCKER_PRUNE_KEEP_LABELS="com.example.keep com.acme.tier=build"
# Name patterns for images you cannot label, matched against what
# `docker image ls` prints. * also crosses /, a bare repository covers all tags.
# DOCKER_PRUNE_KEEP_IMAGES="variscite:* ghcr.io/acme/*"

# Other tunables (defaults shown)
# RUNNER_IMAGE=ghcr.io/dodi-smart/github-runner
# CACHE_BUDGET_BYTES=64424509440   # host-wide cache budget, split across active slots
# SLOT_IDLE_DAYS=7                 # a slot no runner opened this long is emptied
# WORK_BUDGET_BYTES=10737418240    # work dir limit per slot (0 = no limit)
# PRUNE_FREE_PCT=5                 # full pass with the low-space age below this
# PRUNE_INTERVAL_SECONDS=86400
# PREFETCH_INTERVAL_SECONDS=3600
# Any non-empty value disables runner self-update ("false" too).
# DISABLE_AUTO_UPDATE=true
