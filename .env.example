# Copy to .env and fill in. Never commit .env.
# Variables interpolated by docker-compose.yml. Per-host examples with the
# target labels live in hosts/ (hetzner, beelink, rpi5).

# GitHub App that registers the runners (required)
APP_ID=
APP_PRIVATE_KEY=
# Org login the runners register against (also used as ORG_NAME)
APP_LOGIN=

# Optional — values match the compose defaults
RUNNER_NAME_PREFIX=runner
LABELS=self-hosted,Linux,X64,docker,x86,large,light,beelink
RUNNER_GROUP=Default

# Runner self-update. The upstream entrypoint tests this with `[ -n ... ]`,
# so ANY non-empty value disables auto-update - "false" included. Leave it
# unset/empty to keep auto-update on; set it to e.g. "true" to turn it off.
# DISABLE_AUTO_UPDATE=true

# EPHEMERAL is hard-coded to "true" in docker-compose.yml (each runner takes
# one job, then a fresh container registers again; the caches live on the
# named volumes). Setting it here has no effect.

# Nightly pruner (see pruner.sh)
# CACHE_CAP_BYTES=21474836480
# PRUNE_INTERVAL_SECONDS=86400
