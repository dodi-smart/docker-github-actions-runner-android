# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# GitHub App that registers the runners (required)
APP_ID=
APP_PRIVATE_KEY=
# Organization the runners register to
APP_LOGIN=

# How many runners this host runs; `hosts/sizing.sh [light|large]` suggests a
# value from its CPUs, memory and disk.
RUNNERS=3
# Host directory for every runner's work dir and caches, mounted at the same
# path in the containers (slots/<id>/work, slots/<id>/cache). Put it on a disk
# with room; old named volumes from before slots can be removed.
# RUNNER_DATA_DIR=/var/lib/github-runner

# Runner identity. The runner adds self-hosted, the OS and the architecture to
# LABELS itself; add the capability labels your workflows select on.
RUNNER_NAME_PREFIX=runner
LABELS=docker
RUNNER_GROUP=Default
# One runner can join an extra pool, e.g. a host whose runners are `light` with
# one that also builds (slot 3):
# RUNNER_3_LABELS=docker,x86,light,large

# Coordination runners labelled CONTROL_LABELS, for the short jobs a merge
# waits on. None unless set:
# CONTROL_RUNNERS=2
# CONTROL_LABELS=control

# Small hosts without room for caches (e.g. ARM64 boards): jobs then start
# cold. The pruner's budget already shrinks with the disk, so try that first.
# RUNNER_CACHES=off

# Action archive cache (see README). Space-separated owner/repo@ref lists.
# PREFETCH_SOURCES=my-org/my-workflows@main   # repos scanned for `uses:`
# PREFETCH_EXTRA=actions/checkout@v4          # actions fetched as-is

# Other tunables (defaults shown)
# RUNNER_IMAGE=ghcr.io/dodi-smart/github-runner
# CACHE_BUDGET_BYTES=64424509440   # host-wide cache budget, split across slots
# PRUNE_INTERVAL_SECONDS=86400
# PREFETCH_INTERVAL_SECONDS=3600
# Any non-empty value disables runner self-update ("false" too).
# DISABLE_AUTO_UPDATE=true
