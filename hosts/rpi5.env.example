# Host .env for the rpi5 ARM64 pool (agent and utility runners).
# Copy to .env next to docker-compose.yml. Never commit .env.
#
# Target labels (CI redesign): agent + utility pool. NOT `light` (light jobs
# assume X64: Flutter, bun, zavet failed when ARM64 runners carried it) and
# NOT `large`.
# The runner binary adds self-hosted/Linux/ARM64 itself; they are listed to
# keep the whole set visible in one place.
APP_ID=
APP_PRIVATE_KEY=
APP_LOGIN=

RUNNER_NAME_PREFIX=rpi5
LABELS=self-hosted,Linux,ARM64,docker,agent,rpi5
RUNNER_GROUP=Default

# Do not mount the heavy cache volumes on the Pi: layer the override that
# keeps only docker.sock + the work volume (see hosts/rpi5.compose.yml).
COMPOSE_FILE=docker-compose.yml:hosts/rpi5.compose.yml

# Runners are ephemeral (set in docker-compose.yml). Leave DISABLE_AUTO_UPDATE
# unset: ANY non-empty value, even "false", disables runner self-update.
