# Host .env for the beelink X64 pool (3 runners, the default docker-compose.yml).
# Copy to .env next to docker-compose.yml. Never commit .env.
#
# Target labels (CI redesign):
#   large  -> heavy jobs (Gradle/Android, Next.js builds)
#   light  -> overflow for light jobs, resolved by GitHub's own queue
# The runner binary adds self-hosted/Linux/X64 itself; they are listed to keep
# the whole set visible in one place.
APP_ID=
APP_PRIVATE_KEY=
APP_LOGIN=

RUNNER_NAME_PREFIX=beelink
LABELS=self-hosted,Linux,X64,docker,x86,large,light,beelink
RUNNER_GROUP=Default

# Runners are ephemeral (set in docker-compose.yml). Leave DISABLE_AUTO_UPDATE
# unset: ANY non-empty value, even "false", disables runner self-update.
