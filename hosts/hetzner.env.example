# Host .env for the hetzner X64 pool. If a host runs more than one stack, give
# each stack its own RUNNER_NAME_PREFIX.
# Copy to .env next to docker-compose.yml. Never commit .env.
#
# Target labels (CI redesign): capability labels the GitHub queue resolves.
#   light  -> default checks, release, deploy steps
#   agent  -> review, triage, assist
# No `large`: heavy jobs (Gradle/Android, Next.js builds) go to the beelinks.
# The runner binary adds self-hosted/Linux/X64 itself; they are listed to keep
# the whole set visible in one place.
APP_ID=
APP_PRIVATE_KEY=
APP_LOGIN=

RUNNER_NAME_PREFIX=hetzner-a
LABELS=self-hosted,Linux,X64,docker,x86,light,agent,hetzner
RUNNER_GROUP=Default

# Runners are ephemeral (set in docker-compose.yml). Leave DISABLE_AUTO_UPDATE
# unset: ANY non-empty value, even "false", disables runner self-update.
